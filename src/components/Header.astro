---
import { t, SECTIONS, type Lang, type Section } from '../i18n/ui';
import { href, asset, otherLang } from '../lib/site';
import faculty from '../data/faculty.json';

interface Props {
  lang: Lang;
  slug: string;
  hasCounterpart: boolean;
  section?: Section;
}
const { lang, slug, hasCounterpart, section } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const otherHref = href(other, hasCounterpart ? slug : '');
// Pixel sizes of the faculty's logo files in public/brand/ (the English one is wider).
const LOGO: Record<Lang, { width: number; height: number }> = { en: { width: 1020, height: 143 }, ja: { width: 854, height: 150 } };
---
<div class="proto" role="note">
  <div class="wrap">
    <b>{ui.protoLead}</b>
    <span>{ui.protoText}</span>
    <a href={href(lang, 'status')}>{ui.protoLink}</a>
  </div>
</div>
<nav class="faculty-bar" aria-label={ui.facultyTitle}>
  <div class="wrap">
    <a href={faculty.pages.home[lang]} rel="noopener">{ui.facultyBarSchool}</a>
    <span aria-hidden="true">›</span>
    <a href={faculty.pages.international[lang]} rel="noopener">{ui.facultyBarInternational}</a>
  </div>
</nav>
<header class="site-head">
  <div class="wrap head-top">
    <a class="brand" href={href(lang)}>
      {/* The faculty's own logo, as on the department pages of the faculty site (medical_E|J/tpl/img/logo.png), in the
          page's language. Below 760 px the faculty's emblem replaces it, so the buttons still fit (global.css). */}
      <img class="brand-logo" src={asset(`brand/logo-${lang}.png`)} width={LOGO[lang].width} height={LOGO[lang].height} alt={ui.org} />
      <img class="brand-emblem" src={asset('brand/emblem-192.png')} width="192" height="192" alt={ui.org} />
      <span class="brand-site">{ui.site}</span>
    </a>
    <div class="head-actions">
      <a class="search-link" href={href(lang, 'search')} aria-current={slug === 'search' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
        <span class="search-label">{ui.search}</span>
      </a>
      <a class="lang-switch" href={otherHref} hreflang={other}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c-2.5 2.4-3.8 5.4-3.8 9s1.3 6.6 3.8 9c2.5-2.4 3.8-5.4 3.8-9S14.5 5.4 12 3z"></path></svg>
        <span lang={other}>{ui.otherLang}</span><span class="visually-hidden">{ui.otherLangLabel}</span>
      </a>
      <details class="menu-toggle">
        <summary>{ui.menu}</summary>
        <nav class="menu-panel" aria-label={ui.navPanel}>
          <a href={href(lang)} aria-current={slug === '' ? 'page' : undefined}>{ui.home}</a>
          {SECTIONS.map((s) => <a href={href(lang, s)} aria-current={slug === s ? 'page' : undefined} class={section === s ? 'is-active' : undefined}>{ui.sections[s]}</a>)}
        </nav>
      </details>
    </div>
  </div>
  <nav class="nav" aria-label={ui.navMain}>
    <div class="wrap">
      <ul>
        {SECTIONS.map((s) => (
          <li><a href={href(lang, s)} class={section === s ? 'is-active' : undefined} aria-current={slug === s ? 'page' : undefined}>{ui.sections[s]}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>
