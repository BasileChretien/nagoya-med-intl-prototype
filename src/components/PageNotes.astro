---
import { t, type Lang } from '../i18n/ui';
import { tx } from '../i18n/extra';
import { href } from '../lib/site';

interface Props {
  lang: Lang;
  status: 'verified' | 'to-confirm' | 'draft-translation';
  toConfirm: string[];
  /** "top": the translation note; "bottom": a one-line pointer to the facts still to confirm. */
  place: 'top' | 'bottom';
}
const { lang, status, toConfirm, place } = Astro.props;
const ui = t(lang);
const x = tx(lang);
// The facts to confirm are listed in full on the status page (the office's checklist), not on public pages.
---
{place === 'top' && status === 'draft-translation' && (
  <p class="notice translation" role="note">{ui.draftTranslation}</p>
)}
{place === 'bottom' && toConfirm.length > 0 && (
  <p class="notice checking" role="note">{x.stillChecking} <a href={href(lang, 'status')}>{x.seeChecklist}</a></p>
)}
