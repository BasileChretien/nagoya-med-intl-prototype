---
import { getEntry } from 'astro:content';
import { t, fill, type Lang } from '../i18n/ui';
import { tx } from '../i18n/extra';
import type { ProgrammeEntry } from '../lib/site';
import { formatDate, href, checkedAgainstOfficial } from '../lib/site';
import { programmeDeadline, shownStatus, todayJapan } from '../lib/calendar';
import EmailLink from './EmailLink.astro';
import PhoneLink from './PhoneLink.astro';

interface Props { programme: ProgrammeEntry; lang: Lang; showTitle?: boolean }
const { programme, lang, showTitle = true } = Astro.props;
const ui = t(lang);
const x = tx(lang);
const d = programme.data;
const open = d.toConfirm.length;
// A calendar file exists only for a coming dated deadline (src/pages/[lang]/deadlines/[id].ics.ts).
const today = todayJapan();
const dated = programmeDeadline(programme, lang, '', today);
const status = d.deadline ? shownStatus(d.deadline, today) : undefined;
const contact = await getEntry('contacts', d.contact);
type Key = 'audience' | 'duration' | 'capacity' | 'cost' | 'funding' | 'degree' | 'language' | 'eligibility' | 'howToApply';
const rows: Key[] = ['audience', 'duration', 'capacity', 'degree', 'cost', 'funding', 'language', 'eligibility', 'howToApply'];
---
<section class="facts" aria-label={`${ui.factsTitle}: ${d.name[lang]}`}>
  {showTitle && (
    <div class="facts-head">
      <h2>{d.name[lang]}</h2>
      {status && <span class={`pill ${status}`}>{ui.deadlineStatus[status]}</span>}
    </div>
  )}
  <dl>
    {rows.filter((k) => d[k]).map((k) => (
      <>
        <dt>{ui.facts[k]}</dt>
        <dd>{d[k]![lang]}</dd>
      </>
    ))}
    {d.deadline && (
      <>
        <dt>{ui.facts.deadline}</dt>
        <dd>
          {d.deadline.date ? `${formatDate(d.deadline.date, lang)} · ` : ''}{d.deadline.text[lang]}
          {dated && <> · <a href={`${href(lang, 'deadlines')}${programme.id}.ics`} type="text/calendar">{ui.addToCalendar}</a></>}
        </dd>
      </>
    )}
    {contact && (
      <>
        <dt>{ui.facts.contact}</dt>
        <dd>
          {contact.data.label[lang]}<br />
          <span class="visually-hidden">{ui.contactEmail}: </span><EmailLink email={contact.data.email} />
          {contact.data.phone && <><br /><span class="visually-hidden">{ui.contactPhone}: </span><PhoneLink phone={contact.data.phone} lang={lang} /></>}
        </dd>
      </>
    )}
  </dl>
  <p class="facts-meta">
    {fill(checkedAgainstOfficial(d.sources) ? x.checkedOn : x.updatedOn, { date: formatDate(d.checked, lang) })}
    {open > 0 && <a href={`${href(lang, 'status')}#programme-${programme.id}`}>{open === 1 ? x.confirmOne : fill(x.confirmMany, { n: open })}</a>}
  </p>
</section>
