---
import type { ImageEntry } from '../lib/reports';
import type { Lang } from '../i18n/ui';
import { asset } from '../lib/site';

interface Props {
  image: ImageEntry;
  lang: Lang;
  /** Use the small file (cards). */
  small?: boolean;
  /** Show the caption under the photo. */
  caption?: boolean;
  eager?: boolean;
  class?: string;
}
const { image, lang, small = false, caption = false, eager = false, class: cls } = Astro.props;
const d = image.data;
const src = asset(small && d.thumb ? d.thumb : d.file);
const ratio = d.height / d.width;
const w = small ? Math.min(560, d.width) : d.width;
const h = Math.round(w * ratio);
---
<figure class:list={['photo', cls]}>
  <img
    src={src}
    alt={d.alt[lang]}
    width={w}
    height={h}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    {...(d.thumb && !small ? { srcset: `${asset(d.thumb)} 560w, ${asset(d.file)} ${d.width}w`, sizes: '(max-width: 700px) 100vw, 760px' } : {})}
  />
  {caption && d.caption && <figcaption>{d.caption[lang]}</figcaption>}
</figure>
