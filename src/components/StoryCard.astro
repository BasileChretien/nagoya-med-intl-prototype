---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';
import { href, cardImage } from '../lib/site';
import { reportFor, storyImages, excerptOf } from '../lib/reports';

interface Props { story: CollectionEntry<'stories'>; lang: Lang }
const { story, lang } = Astro.props;
const ui = t(lang);
const s = story.data;
const report = await reportFor(story.id, lang);
const machine = report !== null && !report.original;
const excerpt = report ? excerptOf(report.paragraphs) : s.excerpt;
const [photo] = await storyImages(story.id);
const img = photo ? cardImage(photo.data) : null;
const link = href(lang, `stories/${story.id}`);
---
<article class="card story">
  {photo && img && (
    <div class="card-img">
      <img src={img.src} alt={photo.data.alt[lang]} width={img.width} height={img.height} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="meta"><span>{ui.storyTypes[s.type]}</span><span>{s.year}</span><span>{s.country}</span></div>
  <h3><a href={link} lang={s.lang}>{s.name}</a></h3>
  {s.university && s.university !== 'Not stated' && <span class="uni">{s.university}</span>}
  {s.departments.length > 0 && <div>{s.departments.slice(0, 4).map((d) => <span class="badge" lang={s.lang}>{d}</span>)}</div>}
  <blockquote lang={report?.lang ?? s.lang}>{excerpt}{machine && <span class="tag-machine">{ui.machineLabel}</span>}</blockquote>
  <a class="read" href={link}>{ui.readStory} →</a>
</article>
