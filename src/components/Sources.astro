---
import { t, targetMarker, type Lang } from '../i18n/ui';
import { formatDate } from '../lib/site';

interface Props { lang: Lang; sources: string[]; updated?: string }
const { lang, sources, updated } = Astro.props;
const ui = t(lang);
const short = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
{(sources.length > 0 || updated) && (
  <footer class="sources">
    {sources.length > 0 && (
      <>
        <span>{ui.sourcesTitle}</span>
        <ul>{sources.map((s) => {
          const m = targetMarker(s, lang);
          return <li><a href={s} rel="noopener" hreflang={m.hreflang}>{short(s)}</a>{m.text && <span class="target-lang">{lang === 'en' ? ' ' : ''}{m.text}</span>}</li>;
        })}</ul>
      </>
    )}
    {updated && <span>{ui.takenOn}: {formatDate(updated, lang)}</span>}
  </footer>
)}
