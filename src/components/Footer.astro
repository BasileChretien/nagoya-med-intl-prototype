---
import { getCollection } from 'astro:content';
import { t, SECTIONS, OFFICIAL_URL, REPO_URL, type Lang } from '../i18n/ui';
import { href } from '../lib/site';
import faculty from '../data/faculty.json';
import EmailLink from './EmailLink.astro';
import PhoneLink from './PhoneLink.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const contacts = await getCollection('contacts');
const office = contacts.find((c) => c.id === 'intl-office');
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h2>{ui.site}</h2>
        <p>{ui.org}</p>
        {office && (
          <p class="foot-contact">
            {office.data.address && <span>{office.data.address[lang]}</span>}
            <span><span class="visually-hidden">{ui.contactEmail}: </span><EmailLink email={office.data.email} /></span>
            {office.data.phone && <span><span class="visually-hidden">{ui.contactPhone}: </span><PhoneLink phone={office.data.phone} lang={lang} /></span>}
          </p>
        )}
        <ul class="foot-links">
          <li><a href={href(lang, 'about/contact')}>{ui.footerContact}</a></li>
          <li><a href={href(lang, 'about/access')}>{ui.footerAccess}</a></li>
          <li><a href={href(lang, 'about/support')}>{ui.footerSupport}</a></li>
        </ul>
      </div>
      <div>
        <h2>{ui.footerSections}</h2>
        <ul>
          {SECTIONS.map((s) => <li><a href={href(lang, s)}>{ui.sections[s]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{ui.footerMore}</h2>
        <ul>
          <li><a href={href(lang, 'stories')}>{ui.stories}</a></li>
          <li><a href={href(lang, 'news')}>{ui.news}</a></li>
          <li><a href={href(lang, 'programmes')}>{ui.programmesTitle}</a></li>
          <li><a href={href(lang, 'status')}>{ui.footerStatus}</a></li>
        </ul>
      </div>
      <div>
        <h2>{ui.facultyTitle}</h2>
        <ul>
          <li><a href={faculty.pages.directory[lang]} rel="noopener">{ui.facultyDirectory}</a></li>
          <li><a href={faculty.pages.units[lang]} rel="noopener">{ui.facultyUnits}</a></li>
          <li><a href={faculty.pages.international[lang]} rel="noopener">{ui.facultyInternational}</a></li>
        </ul>
      </div>
      <div>
        <h2>{ui.protoLead}</h2>
        <p>{ui.footerAbout}</p>
        <ul style="margin-top:0.6rem">
          <li><a href={OFFICIAL_URL[lang]} rel="noopener">{ui.footerOfficial}</a></li>
          <li><a href={REPO_URL} rel="noopener">{ui.footerSource}</a></li>
        </ul>
      </div>
    </div>
    <p class="foot-note">{ui.protoText}</p>
  </div>
</footer>
