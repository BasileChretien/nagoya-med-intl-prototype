---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t, CONTENT_DATE, type Lang } from '../../../i18n/ui';
import { href, langPaths, formatDate } from '../../../lib/site';

export function getStaticPaths() {
  return langPaths();
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const items = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const years = [...new Set(items.map((n) => n.data.date.slice(0, 4)))];
const cutoff = `${Number(CONTENT_DATE.slice(0, 4)) - 1}${CONTENT_DATE.slice(4)}`;
const hasArchive = items.some((n) => n.data.date < cutoff);
---
<Base lang={lang} title={ui.news} description={ui.newsLede} slug="news">
  <div class="wrap" style="padding-bottom:4rem">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={href(lang)}>{ui.home}</a></li><li aria-current="page">{ui.news}</li></ol></nav>
    <header class="page-head"><h1>{ui.news}</h1><p class="lede">{ui.newsLede}</p></header>
    {hasArchive && <p class="notice" role="note" style="margin-bottom:1.5rem">{ui.newsPast}</p>}
    {years.map((y) => (
      <section style="margin-bottom:2rem">
        <h2 style="margin-bottom:0.6rem">{y}</h2>
        <ul class="news-list">
          {items.filter((n) => n.data.date.startsWith(y)).map((n) => (
            <li>
              <time datetime={n.data.date}>{formatDate(n.data.date, lang)}</time>
              <div>
                <span class="cat">{ui.newsCategory[n.data.category]}</span>
                {n.data.url ? <a href={n.data.url} rel="noopener">{n.data.title[lang]}</a> : <strong>{n.data.title[lang]}</strong>}
                {n.data.summary && <p>{n.data.summary[lang]}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
