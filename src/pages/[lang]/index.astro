---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DeadlineList from '../../components/DeadlineList.astro';
import StoryCard from '../../components/StoryCard.astro';
import { t, fill, SECTIONS, type Lang } from '../../i18n/ui';
import { href, asset, cardImage, langPaths, programmesIn, formatDate } from '../../lib/site';
import { allImages, pageImages, type ImageEntry } from '../../lib/reports';
import { officeData } from '../../lib/structured';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const programmes = await programmesIn();
const stories = await getCollection('stories');
const partners = await getCollection('partners');
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 5);
const latestYear = Math.max(...stories.map((s) => s.data.year));
const featured = stories
  .filter((s) => s.data.year >= latestYear - 1)
  .sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id))
  .filter((s, i, arr) => arr.findIndex((x) => x.data.type === s.data.type) === i || i < 2)
  .slice(0, 3);
const doors = SECTIONS.filter((s) => s !== 'about');
const office = await getEntry('contacts', 'intl-office');
const structured = office ? [officeData(office, lang, new URL(href(lang), Astro.site).toString())] : [];
// Visitors that the section doors do not name: future partners, companies and research institutes, Nagoya staff,
// parents of Nagoya students and the press. The anchor is the heading's id in each language (the page opens anyway).
const moreDoors: { path: string; hash?: Record<Lang, string> }[] = [
  { path: 'partnerships/become-a-partner' },
  { path: 'partnerships/companies' },
  { path: 'partnerships/for-faculty' },
  { path: 'study-abroad/safety', hash: { en: 'for-parents', ja: '保護者の方へ' } },
  { path: 'about/contact', hash: { en: 'media-and-official-enquiries', ja: '報道機関と公的な問い合わせ' } },
];
const doorPhotos: Partial<Record<(typeof doors)[number], ImageEntry>> = {};
for (const s of doors) {
  const { hero } = await pageImages(s);
  if (hero) doorPhotos[s] = hero;
}

const images = await allImages();
/** A photo named by id in images.json; the build stops if it is missing, so no band turns blank unnoticed. */
function photoById(id: string, what: string): ImageEntry['data'] {
  const photo = images.find((i) => i.id === id)?.data;
  if (!photo) throw new Error(`${what} (${id}) is not in src/data/images.json.`);
  return photo;
}
/** The attributes of a photo behind a band: the thumbnail on phones, the full file on wide screens. */
function bandImage(p: ImageEntry['data']) {
  return {
    src: asset(p.thumb ?? p.file),
    srcset: p.thumb && p.thumbWidth ? `${asset(p.thumb)} ${p.thumbWidth}w, ${asset(p.file)} ${p.width}w` : undefined,
    sizes: '100vw',
    width: p.width,
    height: p.height,
  };
}
// The two photo bands of the office's current exchange site, in its order: the students' group (behind its band
// for students who want to study abroad, here behind the numbers; also a photo of the Study abroad page), then the
// campus from above behind the Frontier-kai (also the top photo of the Support page, which covers the association).
const bandPhoto = photoById('page-a1018404cfdd-study-abroad', 'The photo behind the numbers');
const frontierPhoto = photoById('page-3fa82e61b55a-about-support', 'The photo behind the Frontier-kai band');
const FRONTIER_HASH: Record<Lang, string> = { en: 'alumni-of-study-abroad', ja: '留学経験のある卒業生の方へ' };
// The head of the office's message with his photo, as on the office's current exchange site (src/data/office-head.json).
const head = (await getCollection('officeHead'))[0]?.data;
const headPhoto = head ? photoById(head.photo, 'The photo of the head of the office') : undefined;
const headOriginal: Lang = head?.translated === 'ja' ? 'en' : 'ja';
---
<Base lang={lang} title={ui.heroTitle} description={ui.heroLede} slug="" structured={structured}>
  <section class="hero">
    {/* The hospital and Tsurumai Park from above: the last slide of the office's current exchange site
        (intlexch/japanese/images/slides/8.jpg). Decorative, so it is not listed in images.json. */}
    <picture>
      <source media="(min-width: 901px)" srcset={asset('img/campus-1400.webp')} type="image/webp" />
      <img src={asset('img/campus-900.webp')} alt="" width="900" height="506" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap">
      <h1>{ui.heroTitle}</h1>
      <p>{ui.heroLede}</p>
    </div>
  </section>

  <section class="band" aria-labelledby="doors">
    <div class="wrap">
      <div class="band-head reveal"><h2 id="doors">{ui.doorsTitle}</h2></div>
      <div class="grid cols-4">
        {doors.map((s) => (
          <a class="door reveal" href={href(lang, s)}>
            <div class="door-photo">
              {doorPhotos[s] && <img {...cardImage(doorPhotos[s]!.data)} alt={doorPhotos[s]!.data.alt[lang]} loading="lazy" decoding="async" />}
              <h3 class="door-title"><span>{ui.sections[s]}</span></h3>
            </div>
            <p class="door-who">{ui.sectionWho[s]}</p>
          </a>
        ))}
      </div>
      <h3 class="band-sub" id="more-doors">{ui.moreDoorsTitle}</h3>
      <ul class="grid cols-3 plain-list" aria-labelledby="more-doors">
        {moreDoors.map(({ path, hash }) => (
          <li class="reveal"><a class="card door-more" href={`${href(lang, path)}${hash ? `#${hash[lang]}` : ''}`}><span class="door-more-title">{ui.audienceCards[path]}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band soft" aria-labelledby="dates">
    <div class="wrap">
      <div class="band-head reveal"><h2 id="dates">{ui.keyDates}</h2><p>{ui.keyDatesNote}</p></div>
      <DeadlineList lang={lang} programmes={programmes} limit={8} />
      <p class="band-more"><a class="btn-pill" href={href(lang, 'programmes')}>{ui.allProgrammes}</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="stories">
    <div class="wrap">
      <div class="band-head reveal"><h2 id="stories">{ui.stories}</h2><p>{ui.storiesLede}</p></div>
      <div class="grid cols-3 reveal-each">
        {featured.map((s) => <StoryCard story={s} lang={lang} />)}
      </div>
      <p class="band-more"><a class="btn-pill" href={href(lang, 'stories')}>{fill(ui.allStories, { n: stories.length })}</a></p>
    </div>
  </section>

  <section class="photo-band" aria-labelledby="numbers">
    <img {...bandImage(bandPhoto)} alt="" loading="lazy" decoding="async" />
    <div class="wrap"><div class="photo-panel reveal">
      <div class="band-head"><h2 id="numbers">{ui.numbersTitle}</h2></div>
      <div class="numbers">
        <div class="number"><b>{stories.length}</b><span>{fill(ui.numStories, { year: Math.min(...stories.map((s) => s.data.year)) })}</span></div>
        <div class="number"><b>{partners.length}</b><span>{ui.numPartners}</span></div>
        <div class="number"><b>{programmes.length}</b><span>{ui.numProgrammes}</span></div>
        <div class="number"><b>300+</b><span><a href={href(lang, 'study-in-nagoya/clinical-clerkship')}>{ui.numApplicants}</a></span></div>
      </div>
    </div></div>
  </section>

  <section class="photo-band" aria-labelledby="frontier">
    <img {...bandImage(frontierPhoto)} alt="" loading="lazy" decoding="async" />
    <div class="wrap"><div class="photo-panel photo-panel-narrow reveal">
      <div class="band-head"><h2 id="frontier">{ui.frontierTitle}</h2><p>{ui.frontierText}</p></div>
      <p class="band-more"><a class="btn-pill" href={`${href(lang, 'about/support')}#${FRONTIER_HASH[lang]}`}>{ui.frontierMore}</a></p>
    </div></div>
  </section>

  {head && headPhoto && (
    <section class="band head-message" aria-labelledby="head-message">
      <div class="wrap">
        <div class="band-head reveal"><h2 id="head-message">{ui.headTitle}</h2><p>{head.heading[lang]}</p></div>
        <div class="head-grid">
          <figure class="head-quote reveal-left">
            <blockquote cite={head.source}><p>{head.message[lang]}</p></blockquote>
            <figcaption><b>{head.name[lang]}</b><span>{head.role[lang]}</span></figcaption>
          </figure>
          <img class="head-photo reveal-right" src={asset(headPhoto.file)} width={headPhoto.width} height={headPhoto.height} alt={headPhoto.alt[lang]} loading="lazy" decoding="async" />
        </div>
        {head.translated === lang && (
          <p class="head-note">
            <strong>{ui.machineLead}</strong>{lang === 'en' ? ' ' : ''}{fill(ui.headNote, { lang: ui.langName[headOriginal] })}
            {' '}<a href={head.source} hreflang={headOriginal}>{fill(ui.readOriginal, { lang: ui.langName[headOriginal] })}</a>
          </p>
        )}
        <p class="band-more"><a class="btn-pill" href={href(lang, 'about')}>{ui.headMore}</a></p>
      </div>
    </section>
  )}

  <section class="band" aria-labelledby="news">
    <div class="wrap">
      <div class="band-head reveal"><h2 id="news">{ui.news}</h2></div>
      <ul class="news-list news-home">
        {news.map((n) => (
          <li>
            <time datetime={n.data.date}>{formatDate(n.data.date, lang)}</time>
            <div>
              <span class="cat">{ui.newsCategory[n.data.category]}</span>
              <a href={href(lang, `news/${n.id}`)}>{n.data.title[lang]}</a>
            </div>
          </li>
        ))}
      </ul>
      <p class="band-more"><a class="btn-pill" href={href(lang, 'news')}>{ui.allNews}</a></p>
    </div>
  </section>

  <script is:inline>
    // Blocks fade in once as they come into view (styles: "Motion on scroll" in global.css). A block already in the
    // window is shown at once, before anything is hidden; nothing is hidden for visitors who ask for less motion.
    // A block counts as in view as soon as any part of it is, so even a block taller than the window is shown.
    (() => {
      if (!matchMedia('(prefers-reduced-motion: no-preference)').matches || !('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }
      }, { threshold: 0 });
      for (const b of document.querySelectorAll('.reveal, .reveal-each > *, .reveal-left, .reveal-right')) {
        if (b.getBoundingClientRect().top < innerHeight) b.classList.add('is-in');
        else io.observe(b);
      }
      document.documentElement.classList.add('reveal-on');
    })();
  </script>
</Base>
