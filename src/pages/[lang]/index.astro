---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DeadlineList from '../../components/DeadlineList.astro';
import StoryCard from '../../components/StoryCard.astro';
import { t, fill, SECTIONS, type Lang } from '../../i18n/ui';
import { href, asset, langPaths, programmesIn, formatDate } from '../../lib/site';
import { pageImages, type ImageEntry } from '../../lib/reports';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const programmes = await programmesIn();
const stories = await getCollection('stories');
const partners = await getCollection('partners');
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 5);
const latestYear = Math.max(...stories.map((s) => s.data.year));
const featured = stories
  .filter((s) => s.data.year >= latestYear - 1)
  .sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id))
  .filter((s, i, arr) => arr.findIndex((x) => x.data.type === s.data.type) === i || i < 2)
  .slice(0, 3);
const doors = SECTIONS.filter((s) => s !== 'about');
const doorPhotos: Partial<Record<(typeof doors)[number], ImageEntry>> = {};
for (const s of doors) {
  const { hero } = await pageImages(s);
  if (hero) doorPhotos[s] = hero;
}
---
<Base lang={lang} title={ui.heroTitle} description={ui.heroLede} slug="">
  <section class="hero">
    <picture>
      <source media="(min-width: 901px)" srcset={asset('img/campus-1400.webp')} type="image/webp" />
      <img src={asset('img/campus-900.webp')} alt="" width="900" height="516" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap">
      <h1>{ui.heroTitle}</h1>
      <p>{ui.heroLede}</p>
    </div>
  </section>

  <section class="band" aria-labelledby="doors">
    <div class="wrap">
      <div class="band-head"><h2 id="doors">{ui.doorsTitle}</h2></div>
      <div class="grid cols-4">
        {doors.map((s) => (
          <a class="card door" href={href(lang, s)}>
            {doorPhotos[s] && (
              <span class="card-img"><img src={asset(doorPhotos[s]!.data.thumb ?? doorPhotos[s]!.data.file)} alt={doorPhotos[s]!.data.alt[lang]} width={(doorPhotos[s]!.data.thumb && doorPhotos[s]!.data.thumbWidth) || doorPhotos[s]!.data.width} height={(doorPhotos[s]!.data.thumb && doorPhotos[s]!.data.thumbHeight) || doorPhotos[s]!.data.height} loading="lazy" decoding="async" /></span>
            )}
            <span class="kicker">{ui.sectionWho[s]}</span>
            <h3>{ui.sections[s]}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band soft" aria-labelledby="dates">
    <div class="wrap">
      <div class="band-head">
        <div style="display:grid;gap:0.4rem"><h2 id="dates">{ui.keyDates}</h2><p>{ui.keyDatesNote}</p></div>
        <a class="more-link" href={href(lang, 'programmes')}>{ui.allProgrammes}</a>
      </div>
      <DeadlineList lang={lang} programmes={programmes} limit={8} />
    </div>
  </section>

  <section class="band" aria-labelledby="stories">
    <div class="wrap">
      <div class="band-head">
        <div style="display:grid;gap:0.4rem"><h2 id="stories">{ui.stories}</h2><p>{ui.storiesLede}</p></div>
        <a class="more-link" href={href(lang, 'stories')}>{fill(ui.allStories, { n: stories.length })}</a>
      </div>
      <div class="grid cols-3">
        {featured.map((s) => <StoryCard story={s} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="band soft" aria-labelledby="numbers">
    <div class="wrap">
      <div class="band-head"><h2 id="numbers">{ui.numbersTitle}</h2></div>
      <div class="numbers">
        <div class="number"><b>{stories.length}</b><span>{fill(ui.numStories, { year: Math.min(...stories.map((s) => s.data.year)) })}</span></div>
        <div class="number"><b>{partners.length}</b><span>{ui.numPartners}</span></div>
        <div class="number"><b>{programmes.length}</b><span>{ui.numProgrammes}</span></div>
        <div class="number"><b>300+</b><span>{ui.numApplicants}</span></div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="news">
    <div class="wrap">
      <div class="band-head">
        <h2 id="news">{ui.news}</h2>
        <a class="more-link" href={href(lang, 'news')}>{ui.allNews}</a>
      </div>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <time datetime={n.data.date}>{formatDate(n.data.date, lang)}</time>
            <div>
              <span class="cat">{ui.newsCategory[n.data.category]}</span>
              {n.data.url ? <a href={n.data.url} rel="noopener">{n.data.title[lang]}</a> : <span>{n.data.title[lang]}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
