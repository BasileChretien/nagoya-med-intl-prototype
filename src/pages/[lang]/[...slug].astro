---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FactBox from '../../components/FactBox.astro';
import PageNotes from '../../components/PageNotes.astro';
import Sources from '../../components/Sources.astro';
import CompareTable from '../../components/CompareTable.astro';
import ProgrammeCards from '../../components/ProgrammeCards.astro';
import Photo from '../../components/Photo.astro';
import { pageImages } from '../../lib/reports';
import faculty from '../../data/faculty.json';
import glossary from '../../data/glossary.json';
import { t, type Lang, type Section } from '../../i18n/ui';
import { tx } from '../../i18n/extra';
import { href, asset, pageRef, sectionPages, counterpartExists, programmesIn, type PageEntry, type ProgrammeEntry } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => {
    const ref = pageRef(entry);
    return { params: { lang: ref.lang, slug: ref.slug }, props: { entry } };
  });
}

interface Props { entry: PageEntry }
const { entry } = Astro.props;
const ref = pageRef(entry);
const lang: Lang = ref.lang;
const section: Section = ref.section;
const ui = t(lang);
const x = tx(lang);
const { Content } = await render(entry);
const d = entry.data;
const hasCounterpart = await counterpartExists(lang, ref.slug);
const siblings = await sectionPages(lang, section);
const sectionIndexHref = href(lang, section);

const linked: ProgrammeEntry[] = [];
for (const id of d.programmes) {
  const p = await getEntry('programmes', id);
  if (p) linked.push(p);
}
const sectionProgrammes = ref.isIndex && section !== 'partnerships' && section !== 'about' ? await programmesIn(section) : [];

const partners = ref.slug === 'partnerships/agreements' || ref.slug === 'partnerships/game'
  ? (await getCollection('partners')).sort((a, b) => a.data.region.localeCompare(b.data.region) || a.data.name[lang].localeCompare(b.data.name[lang], lang))
  : [];
const gameMembers = partners.filter((p) => p.data.links.includes('GAME'));
const regions = [...new Set(partners.map((p) => p.data.region))];
const CONTACT_ORDER = ['intl-office', 'jdp-office', 'donations'];
const allContacts = (await getCollection('contacts')).sort((a, b) => (CONTACT_ORDER.indexOf(a.id) + 1 || 99) - (CONTACT_ORDER.indexOf(b.id) + 1 || 99));
const contacts = ref.slug === 'about/contact' ? allContacts : ref.slug === 'about/support' ? allContacts.filter((c) => c.id === 'donations') : [];
const office = ref.slug === 'about/access' ? await getEntry('contacts', 'intl-office') : undefined;
const terms = ref.slug === 'about/glossary' ? glossary : [];
/** "tel:" link and, on Japanese pages, the domestic form of an international number (+81-52-... -> 052-...). */
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
const phoneText = (phone: string) => (lang === 'ja' ? phone.replace(/^\+81-?/, '0') : phone);
const { hero, figures } = await pageImages(ref.slug);
---
<Base lang={lang} title={d.title} description={d.description} slug={ref.slug} hasCounterpart={hasCounterpart} section={section}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={href(lang)}>{ui.home}</a></li>
        {!ref.isIndex && <li><a href={sectionIndexHref}>{ui.sections[section]}</a></li>}
        <li aria-current="page">{d.title}</li>
      </ol>
    </nav>
    <header class="page-head">
      <h1>{d.title}</h1>
      {d.summary && <p class="lede">{d.summary}</p>}
    </header>
    <div class="layout">
      <nav class="side-nav" aria-label={ui.inSection}>
        <h2>{ui.sections[section]}</h2>
        <ul>
          <li><a href={sectionIndexHref} aria-current={ref.isIndex ? 'page' : undefined}>{ui.sectionWho[section]}</a></li>
          {siblings.map((p) => {
            const r = pageRef(p);
            return <li><a href={href(lang, r.slug)} aria-current={r.slug === ref.slug ? 'page' : undefined}>{p.data.title}</a></li>;
          })}
        </ul>
      </nav>
      <div class="content">
        <PageNotes lang={lang} status={d.status} toConfirm={d.toConfirm} place="top" />
        {hero && <Photo image={hero} lang={lang} caption eager class="page-hero" />}
        {!ref.isIndex && linked.map((p) => <FactBox programme={p} lang={lang} />)}
        <div class="prose"><Content /></div>
        {figures.length > 0 && (
          <section class="gallery" aria-label={ui.photosTitle}>
            {figures.map((img) => <Photo image={img} lang={lang} small caption />)}
          </section>
        )}

        {ref.isIndex && siblings.length > 0 && (
          <section class="grid cols-2" aria-label={ui.inSection}>
            {siblings.map((p) => (
              <a class="card" href={href(lang, pageRef(p).slug)}>
                <h3>{p.data.title}</h3>
                {p.data.summary && <p>{p.data.summary}</p>}
              </a>
            ))}
          </section>
        )}

        {section === 'degrees' && ref.isIndex && sectionProgrammes.length > 0 && (
          <section>
            <h2 style="margin-bottom:1rem">{ui.programmesTitle}</h2>
            <CompareTable lang={lang} programmes={sectionProgrammes} caption={ui.programmesTitle} />
          </section>
        )}
        {section !== 'degrees' && ref.isIndex && sectionProgrammes.length > 0 && (
          <section style="display:grid;gap:1rem">
            <h2>{ui.programmesTitle}</h2>
            <ProgrammeCards lang={lang} programmes={sectionProgrammes} />
          </section>
        )}

        {ref.slug === 'about' && (
          <section class="grid cols-2" aria-label={ui.facultyTitle}>
            <a class="card" href={faculty.pages.directory[lang]} rel="noopener">
              <span class="kicker">{ui.facultyTitle}</span>
              <h3>{ui.facultyDirectory}</h3>
              <p>{ui.facultyDirectoryText}</p>
            </a>
            <a class="card" href={faculty.pages.units[lang]} rel="noopener">
              <span class="kicker">{ui.facultyTitle}</span>
              <h3>{ui.facultyUnits}</h3>
              <p>{ui.facultyUnitsText}</p>
            </a>
          </section>
        )}

        {ref.slug === 'partnerships/game' && gameMembers.length > 0 && (
          <section style="display:grid;gap:0.9rem">
            <h2>GAME</h2>
            <div class="people">
              {gameMembers.map((p) => (
                <div class="person"><span class="avatar" aria-hidden="true">{p.data.countryCode}</span><div><b>{p.data.name[lang]}</b><span>{p.data.country[lang]}</span></div></div>
              ))}
            </div>
          </section>
        )}

        {ref.slug === 'partnerships/agreements' && (
          <>
            <p class="tag-legend"><b>{x.tagLegend}:</b> {Object.values(x.tags).map((tag) => <span><span class="badge">{tag.label}</span> {tag.title}</span>)}</p>
            <p class="list-counts"><b>{x.inThisList}:</b> {partners.length} {x.institutions} · {Object.entries(x.tags).map(([key, tag]) => ({ tag, n: partners.filter((p) => (p.data.links as string[]).includes(key)).length })).filter(({ n }) => n > 0).map(({ tag, n }) => `${tag.label} ${n}`).join(' · ')}</p>
            <form id="agreement-filter" class="list-filter" role="search" hidden>
              <label>{x.search}<input type="search" name="q" autocomplete="off" /></label>
              <label>{x.regionLabel}<select name="region"><option value="">{x.allRegions}</option>{regions.map((r) => <option value={r}>{ui.regions[r] ?? r}</option>)}</select></label>
              <label>{x.tagLabel}<select name="tag"><option value="">{x.allTags}</option>{Object.entries(x.tags).map(([key, tag]) => <option value={key}>{tag.label}: {tag.title}</option>)}</select></label>
              <output aria-live="polite" data-template={x.showing} data-none={x.noMatch} data-total={partners.length}></output>
            </form>
          </>
        )}
        {ref.slug === 'partnerships/agreements' && (
          <div id="agreements" style="display:grid;gap:1.6rem">
            {regions.map((r) => {
              const rows = partners.filter((p) => p.data.region === r);
              const withYear = rows.some((p) => p.data.since);
              const id = `region-${r.toLowerCase().replace(/\s+/g, '-')}`;
              return (
                <section style="display:grid;gap:0.8rem" data-region={r}>
                  <h2 id={id}>{ui.regions[r] ?? r}</h2>
                  <div class="compare-wrap" role="region" tabindex="0" aria-labelledby={id}>
                    <table class="compare">
                      <caption class="visually-hidden">{ui.regions[r] ?? r}</caption>
                      <thead>
                        <tr>
                          <th scope="col">{x.institution}</th>
                          <th scope="col">{x.country}</th>
                          {withYear && <th scope="col">{x.since}</th>}
                          <th scope="col">{x.links}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {rows.map((p) => (
                          <tr data-tags={p.data.links.join(' ')} data-text={`${p.data.name.en} ${p.data.name.ja} ${p.data.country.en} ${p.data.country.ja}`.toLowerCase()}>
                            <th scope="row">{p.data.url ? <a href={p.data.url} rel="noopener">{p.data.name[lang]}</a> : p.data.name[lang]}</th>
                            <td>{p.data.country[lang]}</td>
                            {withYear && <td>{p.data.since ?? <span class="muted">{x.notRecorded}</span>}</td>}
                            <td>{p.data.links.map((l) => <span class="badge" title={x.tags[l]?.title}>{x.tags[l]?.label ?? l}</span>)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </section>
              );
            })}
          </div>
        )}
        {ref.slug === 'partnerships/agreements' && (
          <script is:inline>
            // Search and filters for the partner list. Without JavaScript the full list shows and the form stays hidden.
            (() => {
              const form = document.getElementById('agreement-filter');
              const list = document.getElementById('agreements');
              if (!form || !list) return;
              form.hidden = false;
              const q = form.elements.namedItem('q');
              const region = form.elements.namedItem('region');
              const tag = form.elements.namedItem('tag');
              const out = form.querySelector('output');
              const params = new URLSearchParams(location.search);
              q.value = params.get('q') ?? '';
              region.value = params.get('region') ?? '';
              tag.value = params.get('tag') ?? '';
              const apply = () => {
                const text = q.value.trim().toLowerCase();
                let shown = 0;
                for (const section of list.querySelectorAll('section[data-region]')) {
                  let inSection = 0;
                  for (const row of section.querySelectorAll('tbody tr')) {
                    const ok = (!region.value || section.dataset.region === region.value)
                      && (!tag.value || row.dataset.tags.split(' ').includes(tag.value))
                      && (!text || row.dataset.text.includes(text));
                    row.hidden = !ok;
                    if (ok) inSection += 1;
                  }
                  section.hidden = inSection === 0;
                  shown += inSection;
                }
                out.textContent = shown ? out.dataset.template.replace('{n}', shown).replace('{total}', out.dataset.total) : out.dataset.none;
                const next = new URLSearchParams();
                if (q.value) next.set('q', q.value);
                if (region.value) next.set('region', region.value);
                if (tag.value) next.set('tag', tag.value);
                history.replaceState(null, '', `${next.toString() ? `?${next}` : location.pathname}${location.hash}`);
              };
              form.addEventListener('input', apply);
              form.addEventListener('submit', (event) => event.preventDefault());
              apply();
            })();
          </script>
        )}

        {office && (
          <section class="contact-card office-box" aria-labelledby="office-box-heading">
            <h2 id="office-box-heading">{x.officeBox}</h2>
            <dl>
              {office.data.location && <><dt>{x.location}</dt><dd>{office.data.location[lang]}</dd></>}
              {office.data.address && <><dt>{x.address}</dt><dd>{office.data.address[lang]}</dd></>}
              <dt>{ui.contactEmail}</dt><dd><a href={`mailto:${office.data.email}`}>{office.data.email}</a></dd>
              {office.data.phone && <><dt>{ui.contactPhone}</dt><dd><a href={tel(office.data.phone)}>{phoneText(office.data.phone)}</a></dd></>}
            </dl>
            <ul class="link-list">
              <li><a href={asset(`files/route-map-${lang}.pdf`)} type="application/pdf">{x.routeGuide}</a></li>
              <li><a href={asset(`files/route-map-${lang === 'ja' ? 'en' : 'ja'}.pdf`)} type="application/pdf" hreflang={lang === 'ja' ? 'en' : 'ja'}>{x.routeGuideOther}</a></li>
              {office.data.map && <li><a href={`https://www.openstreetmap.org/?mlat=${office.data.map.lat}&mlon=${office.data.map.lng}#map=18/${office.data.map.lat}/${office.data.map.lng}`} rel="noopener">{x.openMap}</a></li>}
            </ul>
          </section>
        )}

        {terms.length > 0 && (
          <dl class="glossary">
            {terms.map((g) => (
              <div id={`term-${g.term.toLowerCase()}`}>
                <dt><abbr title={g[lang]}>{g.term}</abbr></dt>
                <dd>
                  {g[lang]}{g.confirmed === false && ` (${x.unconfirmed})`}
                  {g.url && <> · <a href={g.url[lang] ?? g.url.en} rel="noopener">{x.website}</a></>}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {contacts.length > 0 && (
          <section class="grid cols-2">
            {contacts.map((c) => (
              <div class="contact-card">
                <h3>{c.data.label[lang]}</h3>
                <p style="color:var(--muted);font-size:0.94rem">{c.data.audience[lang]}</p>
                <dl>
                  <dt>{ui.contactEmail}</dt><dd><a href={`mailto:${c.data.email}`}>{c.data.email}</a></dd>
                  {c.data.phone && <><dt>{ui.contactPhone}</dt><dd><a href={tel(c.data.phone)}>{phoneText(c.data.phone)}</a></dd></>}
                  {c.data.fax && <><dt>{ui.contactFax}</dt><dd>{c.data.fax}</dd></>}
                  {c.data.address && <><dt>{ui.contactAddress}</dt><dd>{c.data.address[lang]}</dd></>}
                  {c.data.location && <><dt>{x.location}</dt><dd>{c.data.location[lang]} · <a href={href(lang, 'about/access')}>{x.howToReach}</a></dd></>}
                </dl>
              </div>
            ))}
          </section>
        )}

        <PageNotes lang={lang} status={d.status} toConfirm={d.toConfirm} place="bottom" />
        <Sources lang={lang} sources={d.sources} updated={d.updated} />
      </div>
    </div>
  </div>
</Base>

<style is:global>
  /* Acronyms (rehype-abbr), the abbreviations list, the access box and the agreements legend. */
  abbr[title] { text-decoration: underline dotted; text-underline-offset: 0.18em; cursor: help; }
  .abbrevs { margin-top: 2rem; padding: 1rem 1.2rem; border: 1px solid var(--line, #d9dee5); border-radius: 10px; background: var(--paper-2, #f6f8fa); }
  .abbrevs h2 { font-size: 1rem; margin: 0 0 0.6rem; }
  .abbrevs dl, dl.glossary { display: grid; gap: 0.35rem; margin: 0; }
  .abbrevs dl > div, dl.glossary > div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.8rem; }
  .abbrevs dt, dl.glossary dt { font-weight: 700; }
  .abbrevs dd, dl.glossary dd { margin: 0; }
  .abbrevs p { margin: 0.7rem 0 0; font-size: 0.94rem; }
  dl.glossary > div { padding: 0.45rem 0; border-bottom: 1px solid var(--line, #d9dee5); }
  .office-box h2 { font-size: 1.1rem; margin: 0 0 0.6rem; }
  .link-list { margin: 0.8rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  .tag-legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.92rem; color: var(--muted); }
  .tag-legend .badge { margin-right: 0.25rem; }
  .notice.checking { font-size: 0.92rem; }
  /* hidden must win over the display set on these blocks (sections and the filter form). */
  #agreements [hidden], .list-filter[hidden] { display: none !important; }
  .list-counts { font-size: 0.92rem; color: var(--muted); }
  .list-filter { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: end; padding: 0.9rem 1rem; border: 1px solid var(--line, #d9dee5); border-radius: 10px; }
  .list-filter label { display: grid; gap: 0.25rem; font-size: 0.9rem; font-weight: 600; }
  .list-filter input, .list-filter select { font: inherit; font-weight: 400; padding: 0.35rem 0.5rem; border: 1px solid var(--line, #c5ccd6); border-radius: 6px; max-width: 22rem; }
  .list-filter output { flex-basis: 100%; font-size: 0.92rem; color: var(--muted); }
  .muted { color: var(--muted); }
  @media (max-width: 560px) { .abbrevs dl > div, dl.glossary > div { grid-template-columns: 1fr; gap: 0.1rem; } }
</style>
