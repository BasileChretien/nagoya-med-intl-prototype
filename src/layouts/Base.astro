---
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang, type Section } from '../i18n/ui';
import { href, asset, otherLang } from '../lib/site';
import { jsonLdText, type JsonLd } from '../lib/structured';
import { PROTOTYPE } from '../lib/launch.mjs';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language segment, without slashes at the ends; "" for the home page. */
  slug: string;
  /** Whether the same page exists in the other language. */
  hasCounterpart?: boolean;
  section?: Section;
  /** Structured data for search engines (src/lib/structured.ts). */
  structured?: JsonLd[];
  /** Whether the site search indexes this page (Pagefind). False for the office checklist and the 404 page. */
  searchable?: boolean;
}

const { lang, title, description, slug, hasCounterpart = true, section, structured = [], searchable = true } = Astro.props;
const ui = t(lang);
const fullTitle = slug === '' ? `${ui.site} | ${ui.org}` : `${title} | ${ui.site} | ${ui.org}`;
const self = new URL(href(lang, slug), Astro.site).toString();
const other = otherLang(lang);
const otherUrl = new URL(href(other, hasCounterpart ? slug : ''), Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Prototype: keep it out of search engines so it never competes with the official sites (src/lib/launch.mjs). -->
    {PROTOTYPE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={self} />
    <link rel="alternate" hreflang={lang} href={self} />
    {hasCounterpart && <link rel="alternate" hreflang={other} href={otherUrl} />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={ui.newsFeed} href={`${href(lang, 'news')}rss.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_GB'} />
    <meta name="theme-color" content="#2d3986" />
    {structured.map((data) => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header lang={lang} slug={slug} hasCounterpart={hasCounterpart} section={section} />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
