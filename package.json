{
  "name": "nagoya-med-intl-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype of a single bilingual international website for Nagoya University Graduate School of Medicine. Not an official site.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check-content.mjs && node scripts/check-staleness.mjs",
