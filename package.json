{
  "name": "nagoya-med-intl-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype of a single bilingual international website for Nagoya University Graduate School of Medicine. Not an official site.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "node scripts/check-content.mjs && node scripts/check-staleness.mjs",
    "typecheck": "astro check",
    "test": "node scripts/test-checks.mjs && node scripts/test-staleness.mjs && node scripts/test-content-plugin.mjs && node scripts/test-tools.mjs",
    "weekly-check": "node --max-http-header-size=65536 scripts/weekly-check.mjs",
    "sync": "node scripts/sync.mjs",
    "faculty-texts": "node scripts/build-faculty-texts.mjs",
    "check:faculty": "node scripts/check-faculty-live.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.13",
    "ics": "3.12.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pagefind": "1.6.0",
    "typescript": "6.0.3"
  }
}
